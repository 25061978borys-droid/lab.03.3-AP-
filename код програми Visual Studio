#include <iostream>
#include <cmath>
using namespace std;
int main()
{
	double x; // вхідний аргумент
	double R; // вхідний параметр
	double R1; // вхідний параметр
	double R2; // вхідний параметр
	double y; // результат обчислення виразу

	cout << "R = "; cin >> R;
	cout << "x = "; cin >> x;
	cout << "R1 = "; cin >> R1;
	cout << "R2 = "; cin >> R2;

	// розгалуження в повній формі
	if (x <= (-R1))
		y = ((R1 / (R2 - 2)) * (x + 2));
	else
		if (-R1 < x && x <= 0)
			y = R + sqrt((R1 * R1) - (x * x));
		else
			if (0 < x && x <= R2)
				y = -sqrt((R * R) - ((x * x) - (R2 * R2)));
			else
				if (R2 < x <= 4)
					y = -R1;
				else
					y = -R1 + ((R1 / 2) * (x - 4));

	cout << endl;
	cout << "y = " << y << endl;
	cin.get();
	return 0;
}
